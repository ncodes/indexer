<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      You have been invited to mediate for a <a href="https://app.joint.exchange/market/{{market.address}}">market</a>.
      Review and accept the invitation to gain permission to join the market as a mediator.
      <br><br>
      <div class="alert" {{> alertStyle }}>
        <div style="padding: 5px 10px;">{{> badgeInfo label='INFO' }} If you accept it, your ticket can join the market to offer mediation service.</div>
        <div style="padding: 5px 10px; color: #4d4b4b; border-top: 1px solid #f7f7f7;">{{> badgeInfo label='INFO' }} You can ignore the invite if you do not want to accept it.</div>
      </div>
      <br />
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


