<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      {{invitee}} has accepted your invitation to join your <a href="{{marketLink}}">market</a> as a mediator.
      <br><br>
      <div class="alert" {{> alertStyle }}>
        <div style="padding: 5px 10px;">{{> badgeInfo label='INFO' }} The invitee is now free to join your market with a ticket that is valid and has sufficient security bond.</div>
      </div>
      <br />
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


