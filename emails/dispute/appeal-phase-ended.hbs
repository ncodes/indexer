<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      The appeal window for dispute #{{disputeId}} has closed. No re-appeal can be created.
      <br /><br />
      <div class="alert" {{> alertStyle }}>
          <div style="padding: 5px 10px; ">{{> badgeInfo label='INFO' }} The dispute outcome will now be executed.</div>
      </div>
      <br>
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


