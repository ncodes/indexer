<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      A new mediator ticket owned by {{ownerShort}} has joined your <a href="{{marketLink}}">market</a>.
      The new ticket would be randomly drafted into future dispute resolution rounds.
      <br /><br />
      <div class="alert" {{> alertStyle }}>
        <div style="padding: 5px 10px; ">{{> badgeInfo label='INFO' }} Your market now has <b>{{numTickets}}</b> ticket{{pluralS}}</div>
      </div>
      <br>
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


