  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "yarn mig:test:up && jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "mig:test:up": "knex-migrate up --env=test",
    "mig:test:rollback": "knex-migrate rollback --env=test",
    "mig:dev:up": "knex-migrate up --env=development",
    "mig:dev:rollback": "knex-migrate rollback --env=development",
    "mig:prod:up": "knex-migrate up --env=production",
    "mig:prod:rollback": "knex-migrate rollback --env=production",
    "typechain": "typechain --target ethers-v5 --out-dir typechain abi/*.json"
  },
