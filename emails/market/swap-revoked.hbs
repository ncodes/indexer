<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      You are no longer allowed to perform swap operations in a <a href="{{marketLink}}">market</a>.
      The market creator has revoked your swap permission.
      <br /><br />
      <div class="alert" {{> alertStyle }}>
        <div style="padding: 5px 10px; ">{{> badgeInfo label='INFO' }} You will still be able to complete ongoing swap orders.</div>
      </div>
      <br>
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


