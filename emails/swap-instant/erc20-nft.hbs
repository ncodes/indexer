<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      Your liquidity was involved in an instant swap event. <b>{{amount}} {{market.base}}</b> was swapped for <b>{{quoteSize}} {{market.quote}}</b> token{{pluralStr}} ({{>printTokenIDs ids=swap.takerIds}}).
      <br><br>
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


