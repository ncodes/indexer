<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      {{#not dispute.redisputed}}
        A dispute has been initiated regarding an order in which you are involved.
      {{else}}
        A previously disputed order you are involved in has been redisputed.
      {{/not}}
      The counterparty, {{creatorShort}}, wants the order to be <b>{{#if dispute.wantRelease}}released{{else}}cancelled{{/if}}</b>.
      <br /><br />
      <div class="alert" {{> alertStyle }}>
        <div style="padding: 5px 10px; ">{{> badgeInfo label='INFO' }} <b>Dispute Status</b>: drafting mediators</div>
        <div style="padding: 5px 10px; border-top: 1px dashed #f7f7f7">{{> badgeInfo label='INFO' }} <b>Mediators Required</b>: {{dispute.numMediators}}</div>
        <div style="padding: 5px 10px; border-top: 1px dashed #f7f7f7">{{> badgeInfo label='INFO' }} Once all mediators are drafted, you will need to respond to request for evidence against {{#if dispute.wantRelease}}releasing{{else}}cancelling{{/if}} the order.</div>
      </div>
      <br>
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


