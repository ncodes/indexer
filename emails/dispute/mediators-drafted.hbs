<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      The evidence submission phase for a dispute you are involved in has begun.
      You are expected to submit evidences to support your preferred outcome.
      <br /><br />
      <div class="alert" {{> alertStyle }}>
        <div style="padding: 5px 10px; ">{{> badgeInfo label='INFO' }} Evidence submission ends in: <b>{{evidencePhaseHoursLeft}}</b></div>
        <div style="padding: 5px 10px; border-top: 1px dashed #f7f7f7">{{> badgeDanger label='DANGER' }} Non-participation in the dispute process may lead to an outcome that is not in your favor.</div>
      </div>
      <br>
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


