{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "globals": {
    "ts-jest": {
      "isolatedModules": true,
      "tsconfig": {
        "allowJs": true
      }
    }
  },
  "transform": {
    "^.+\\.[tj]s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "<rootDir>/node_modules/(?!defer-promise)"
  ]
}
