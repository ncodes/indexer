<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      Your offer has been accepted by the liquidity provider.
      <br><br>
      <div class="alert" {{> alertStyle }}>
        <div style="padding: 5px 10px; border-top: 1px solid #f7f7f7;">{{> badgeInfo label='INFO' }}  <b>Can be executed after: </b> {{execTime}}</div>
        <div style="padding: 5px 10px; border-top: 1px solid #f7f7f7;">{{> badgeInfo label='INFO' }}  The liquidity provider can still reject the offer if they change their mind before execution.</div>
      </div>
      <br>
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


