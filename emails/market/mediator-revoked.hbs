<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      You have been removed as a mediator from a <a href="{{marketLink}}">market</a>.
      Since you are no longer a mediator in this market, you will not be drafted into new disputes originating from it.
      <br><br>
      <div class="alert" {{> alertStyle }}>
        <div style="padding: 5px 10px; ">{{> badgeInfo label='INFO' }} You can immediately remove your ticket from the market, or it will be auto-removed sometime before the next dispute.</div>
      </div>
      <br />
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


