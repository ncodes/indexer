# Application Core Settings
# Name of the application
APP_NAME=Joint
# Port number the application runs on
PORT=3001
# Current environment (development/production/test)
NODE_ENV=development
# Flag to indicate if running in local environment
LOCAL=true
# Base URL for backend services
URL=http://localhost:3001
# Frontend application URL
APP_URL=

# Database and Cache Connections
# Main PostgreSQL database connection string
DATABASE_URL=postgres://postgres:@127.0.0.1:5432/joint?sslmode=disable
# Test PostgreSQL database connection string
DATABASE_URL_TEST=postgres://postgres:@127.0.0.1:5432/joint_test?sslmode=disable
# Redis cache connection string
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security
# Username for root administrator account
ROOT_ADMIN_USER=admin
# Password for root administrator account
ROOT_ADMIN_PASS=admin
# Secret key for JWT token generation
JWT_SECRET=secret_abcdef
# JWT token expiration time in minutes
JWT_EXP_MIN=1440

# Rate Limiting
# Duration in seconds for rate limit window
THROTTLE_TTL=60
# Maximum number of requests allowed within TTL window
THROTTLE_LIMIT=3000

# Feature Flags
# Master switch to disable all features
OFF=false
# Disable all notification sending
DISABLE_NOTIFICATIONS=false
# Disable background notification processing
DISABLE_NOTIFICATIONS_PROCESSING=false
# Disable mining task processing
DISABLE_MINE_TASK_PROCESSING=true
# Disable dispute notification system
DISABLE_DISPUTE_NOTIFIERS=false
# Disable blockchain watcher service
DISABLE_WATCHER=false
# Comma-separated list of specific watchers to disable
DISABLED_WATCHERS=
# Disable automatic currency rate updates
DISABLE_CURRENCY_RATE_FETCHER=true
# Enable market metadata management
ENABLE_MARKET_META_MANAGER=true
# Enable only specific watcher (if set)
ENABLE_ONLY_WATCHER=
# Enable updates for provider message status
ENABLE_PROVIDER_MSG_STATUS_UPDATE=false

# External Services
# URL for the notification microservice
NOTIFICATION_SERVER_URL=http://localhost:8080
# URL for JNT Link API service
JNT_LINK_API_URL=http://localhost:3003
# Authentication key for JNT Link API
JNT_LINK_API_KEY=token

# Web Push Notifications
# Private key for VAPID web push authentication
VAPID_PRIVATE_KEY=
# Public key for VAPID web push authentication
VAPID_PUBLIC_KEY=

# Price and Token Data Sources
# Primary source for token metadata (coinmarketcap/coingecko)
TOKEN_METADATA_SOURCE=coinmarketcap
# Primary source for exchange rates
EXCHANGE_RATE_SOURCE=openexchangerates
# API key for CoinGecko service
COINGECKO_KEY=
# API key for CoinMarketCap service
COINMARKETCAP_KEY=
# API key for Open Exchange Rates service
OPENEXRATES_KEY=

# Email Configuration
# AWS SMTP service username
AWS_SMTP_USERNAME=
# AWS SMTP service password
AWS_SMTP_PASSWORD=

# IPFS Configuration
# Pinata service authentication token
PINATA_JWT_KEY=
# Custom Pinata IPFS gateway URL
PINATA_GATEWAY=
# Public IPFS gateway URL
IPFS_GATEWAY=https://ipfs.io/ipfs/

# File Upload Configurations
# Maximum size for image uploads in bytes (11MB)
FILE_UPLOAD_MAX_IMAGE_SIZE=11534336
# Maximum size for video uploads in bytes (30MB)
FILE_UPLOAD_MAX_VIDEO_SIZE=31457280
# Maximum size for document uploads in bytes (11MB)
FILE_UPLOAD_MAX_DOC_SIZE=11534336
# Allowed MIME types for image uploads
FILE_UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png
# Allowed MIME types for video uploads
FILE_UPLOAD_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/wmv,video/webm
# Allowed MIME types for document uploads
FILE_UPLOAD_ALLOWED_DOC_TYPES=application/pdf

# Market and Task Settings
# Cron schedule for market manager updates
MARKET_MGR_CRON="0 */2 * * *"
# Default type for mining tasks
PREFERRED_MINE_TASK_TYPE=draft
# XMTP messaging environment (dev/prod)
XMTP_ENV=dev

# Badge Configuration
# Identifier for merchant verification badge
MERCHANT_BADGE=merchant
# Identifier for KYC verification badge
KYC_BADGE=kyc
# Identifier for instruction completion badge
INSTRUCTION_BADGE=instruction
# Public key of instruction badge issuer
INSTRUCTION_BADGE_ISSUER_PK=
# Identifier for payment method verification badge
PAYMENT_METHOD_BADGE=pm
# Public key of payment method badge issuer
PAYMENT_METHOD_BADGE_ISSUER_PK=
# Identifier for region verification badge
REGION_BADGE=region

# Business Logic Configuration
# Address of the organization creator for payment router
PAY_ROUTER_ORG_CREATOR_ADDRESS=
# Default country code for new users
DEFAULT_COUNTRY=NG
# Default delay duration for disputes in seconds
DEFAULT_DISPUTE_DELAY_DUR=300

# Blockchain Configuration
# Secret for Infura user agent
INFURA_UA_SECRET=
# Starting block height for localhost network
LAUNCH_HEIGHT_LOCALHOST=1
# Number of blocks to watch in each scan
WATCH_RANGE_LOCALHOST=10

# RPC Endpoints
# Local blockchain node URL
LOCALHOST_RPC_URL="http://127.0.0.1:8545"
# Ethereum mainnet RPC URL
ETHEREUM_RPC_URL=
# Arbitrum mainnet RPC URL
ARBITRUM_RPC_URL=

# Smart Contract Addresses - Localhost
# Asset registry contract address
LOCALHOST_ASSET_REG_ADDRESS=
# Miner registry contract address
LOCALHOST_MINER_REG_ADDRESS=
# Provider registry contract address
LOCALHOST_PROVIDER_REG_ADDRESS=
# Main router contract address
LOCALHOST_ROUTER_ADDRESS=
# Payment router contract address
LOCALHOST_PAY_ROUTER_ADDRESS=
# Market manager contract address
LOCALHOST_MARKET_MGR_ADDRESS=
# Badge manager contract address
LOCALHOST_BADGE_MGR_ADDRESS=
# Core contract address
LOCALHOST_CORE_ADDRESS=
# Dispute manager contract address
LOCALHOST_DISPUTE_MGR_ADDRESS=
# NFT contract address
LOCALHOST_NFT_ADDRESS=
# Energon token contract address
LOCALHOST_ENERGON_ADDRESS=
# Fee pool contract address
LOCALHOST_FEE_POOL_ADDRESS=
# Liquidity pool contract address
LOCALHOST_LP_POOL_ADDRESS=
# Market core contract address
LOCALHOST_MARKET_CORE_ADDRESS=
# Mediator manager contract address
LOCALHOST_MEDIATOR_MGR_ADDRESS=
# Main token contract address
LOCALHOST_TOKEN_ADDRESS=
# Bond curve distribution contract address
LOCALHOST_BOND_CURVE_DISTRO_ADDRESS=
# Wrapped token contract address
LOCALHOST_WRAPPED_TOKEN_ADDRESS=
# UNI token contract address
LOCALHOST_UNI_TOKEN_ADDRESS=
# NGN token contract address
LOCALHOST_NGN_TOKEN_ADDRESS=
# Native ETH token contract address
LOCALHOST_NATIVE_ETH_TOKEN_ADDRESS=