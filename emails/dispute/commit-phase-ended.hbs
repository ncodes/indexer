<table style="margin: auto; width: 100%;  background-color: #ffffff;  border-radius: 5px;">
  <tr>
    <td style="padding: 10px 30px; font-size: 20px; line-height: 30px;">
      Hello {{userAddrShort}},
      <br><br>
      The vote commit phase has ended for dispute #{{disputeId}}.
      {{#if drafted}}It is time to <b>decrypt and reveal</b> your vote{{else}}It is time for the mediators to <b>decrypt and reveal</b> their vote{{/if}}.
      <br /><br />
      <div class="alert" {{> alertStyle }}>
        <div style="padding: 5px 10px; ">{{> badgeInfo label='INFO' }} <b>Reveal Phase Ends in:</b> {{revealPhaseHoursLeft}}.</div>
      </div>
      <br>
      {{> primaryButton this }}
      <br>
      Love, <br>
      {{app}} Team
    </td>
  </tr>
</table>


